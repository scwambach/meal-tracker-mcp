# Your Netlify site URL (no trailing slash)
MEAL_API_URL=https://your-meal-tracker.netlify.app
# Must match MEAL_API_TOKEN set in the Netlify site's environment variables
MEAL_API_TOKEN=change-me
# Secret that protects the MCP endpoint. Generate with: openssl rand -hex 32
# Clients connect to /mcp/<this token>, or to /mcp with "Authorization: Bearer <this token>".
MCP_AUTH_TOKEN=
# IANA timezone used for default meal dates/times
TIMEZONE=America/New_York
PORT=3030
# Cloudflare Tunnel token (only for: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=
