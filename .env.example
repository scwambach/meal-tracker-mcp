# Your Netlify site URL (no trailing slash)
MEAL_API_URL=https://your-meal-tracker.netlify.app
# Must match MEAL_API_TOKEN set in the Netlify site's environment variables
MEAL_API_TOKEN=change-me
# Optional: require "Authorization: Bearer <token>" on /mcp
MCP_AUTH_TOKEN=
# IANA timezone used for default meal dates/times
TIMEZONE=America/New_York
PORT=3030
